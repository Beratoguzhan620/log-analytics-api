# Copy to .env to override the local defaults used by docker compose.
POSTGRES_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
# At least 12 characters. Used only to create the first admin when there are no users.
ADMIN_PASSWORD=change-me-please
# The sample generator's source key. Format: la_<8 lowercase letters or digits>_<at least 32 characters>.
SAMPLE_SOURCE_KEY=la_changeme_replace-this-with-a-long-random-secret-value
