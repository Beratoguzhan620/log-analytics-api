{
  "ConnectionStrings": {
    "Logs": ""
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": "",
    "SampleSourceKey": ""
  },
  "Auth": {
    "LoginAttemptsPerMinute": 10
  },
  "Ingestion": {
    "QueueCapacity": 100000,
    "BatchSize": 2000,
    "FlushInterval": "00:00:00.250",
    "RequestsPerSecondPerSource": 50
  },
  "Alerts": {
    "EvaluationInterval": "00:00:30",
    "NotificationService": {
      "BaseUrl": "",
      "ApiKey": "",
      "Template": "log-alert",
      "RecipientId": "on-call",
      "Email": "",
      "Language": "en"
    }
  },
  "Retention": {
    "Days": 14,
    "DaysAhead": 2,
    "CheckInterval": "01:00:00"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
